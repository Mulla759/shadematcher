{
  "name": "auriga-colour-atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Bare-bones webcam skin-tone and colour-match MVP for Auriga.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/setup-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup:assets": "node scripts/setup-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "scrape": "node scripts/scrape-library.mjs --site velascarves",
    "scrape:all": "node scripts/scrape-library.mjs --all",
    "scrape:oneyard": "node scripts/scrape-oneyard.mjs",
    "library:build": "node scripts/build-index.mjs",
    "library:catalog": "node scripts/build-catalog-index.mjs",
    "library:subset": "node scripts/build-public-library.mjs",
    "library:swatches": "node scripts/make-swatches.mjs",
    "library:vision-pilot": "node scripts/score-pilot.mjs",
    "print-flow": "node scripts/build-print-flow.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@vercel/analytics": "^2.0.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
