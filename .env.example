# Every value here is optional. The app runs with none of them set.

# ——— deployment behaviour ———

# Public beta mode: shows the beta banner + feedback form, keeps the site out
# of search results, and is the flag you flip at launch.
# NEXT_PUBLIC_* values are inlined at build time — set them in the deploy
# environment, not just in a local .env file.
NEXT_PUBLIC_BETA_MODE=1

# Product photography. The scraped library is not in Git and cannot be served
# from a serverless deployment, so photos are off in production unless you set
# this to 1 and host a photo subset (npm run library:subset) at /photos.
# Local development keeps them on automatically.
NEXT_PUBLIC_SHOW_PHOTOS=0

# Product photography in the fabric gallery (/gallery) only. The gallery is a
# published view of the whole collection, so it usually wants the photographs
# even when the reading app is kept photo-free. With this off, every card
# shows the measured colour instead: the hex for a solid, the real gradient
# for an ombré. No third-party request is made either way.
NEXT_PUBLIC_GALLERY_PHOTOS=0

# Foundation matches. The atlas is a generated reference grid, not retail data.
# Set to 0 to switch the section off for public testing.
FOUNDATIONS_ENABLED=0

# Optional contact address shown on /privacy.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional external feedback form. When empty, the built-in form is used.
NEXT_PUBLIC_FEEDBACK_URL=

# Vercel Web Analytics. The script only exists on Vercel, so it is opt-in
# (also enable Analytics in the Vercel dashboard).
NEXT_PUBLIC_ANALYTICS=0

# ——— server infrastructure ———

# Absolute or relative path to the scraped textile library.
# Defaults to "library" inside the project root.
# The library is not in Git — run `npm run scrape:all` to rebuild it locally,
# or point this at a mounted copy on the server.
AURIGA_LIBRARY_DIR=library

# Shared rate limiting (Vercel KV or Upstash Redis). Without these the app
# falls back to in-memory buckets, which do not work across serverless
# instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional webhook that receives feedback and client error reports.
FEEDBACK_WEBHOOK_URL=
